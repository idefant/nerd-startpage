{
  "name": "Nerd Startpage",
  "version": "0.4.4",
  "manifest_version": 3,
  "description": "Lightweight and fast new tab page extension",
  "permissions": [
    "tabs",
    "history",
    "bookmarks",
    "sessions",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/complete/search",
    "https://ya.ru/suggest/suggest-ya.cgi",
    "https://api.npms.io/",
    "https://api.myip.com/"
  ],
  "action": {
    "default_title": "Nerd Startpage"
  },
  "chrome_url_overrides": {
    "newtab": "load.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "open_startpage": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Open Nerd Startpage"
    }
  }
}
